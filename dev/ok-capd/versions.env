# Version contract for the isolated CAPD developer environment.
# Keep CAPI providers on the same release line; do not inherit versions from go.mod.
OK_CAPD_KIND_NAME="ok-capd-dev"
OK_CAPD_NODE_IMAGE="kindest/node:v1.36.4"
OK_CAPD_KUBERNETES_VERSION="v1.36.4"
OK_CAPD_CAPI_VERSION="v1.14.4"
OK_CAPD_CAPD_VERSION="v1.14.4"
OK_CAPD_CERT_MANAGER_VERSION="v1.21.3"

# Disposable CAPD workload smoke cluster (separate from the management cluster).
OK_CAPD_WORKLOAD_NAME="ok-capd-smoke"
OK_CAPD_CONTROL_PLANE_COUNT="1"
OK_CAPD_WORKER_COUNT="1"
OK_CAPD_POD_CIDR="192.168.0.0/16"
OK_CAPD_SERVICE_CIDR="10.128.0.0/12"
