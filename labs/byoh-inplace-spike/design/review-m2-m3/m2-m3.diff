+// Copyright 2026 The Cluster API Provider BringYourOwnHost Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package noreplacement
+
+import (
+	"crypto/subtle"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// TargetKind is the kind of CAPI owner object an Upgrade Grant is bound to.
+type TargetKind string
+
+const (
+	// TargetKubeadmControlPlane binds a grant to a KCP (control-plane in-place).
+	TargetKubeadmControlPlane TargetKind = "KubeadmControlPlane"
+	// TargetMachineDeployment binds a grant to a MachineDeployment (worker in-place).
+	TargetMachineDeployment TargetKind = "MachineDeployment"
+	// TargetMachineSet is used for the MD-ACK transition, where the admitted
+	// object is the approved target MachineSet of the grant's MachineDeployment.
+	TargetMachineSet TargetKind = "MachineSet"
+)
+
+// Enumerated in-place transition IDs. These are the ONLY shapes that may ever be
+// allowed under a grant; every other object change remains denied (ADR-047).
+// The exact per-object diff for each ID is specified and source-verified in
+// labs/byoh-inplace-spike/design/M1-grant-contract-and-transition-matrix.md.
+const (
+	TransitionKCPSetInProgress   = "KCP-1"     // Machine: add update-in-progress
+	TransitionKCPVersionBump     = "KCP-2"     // Machine: spec.version from->to
+	TransitionKCPPendingHook     = "KCP-3"     // Machine: add pending-hooks(UpdateMachine)
+	TransitionKCPCleanupHook     = "KCP-C1"    // Machine: remove pending-hooks(UpdateMachine)
+	TransitionKCPCleanupFlag     = "KCP-C2"    // Machine: remove update-in-progress
+	TransitionKCPInfraInProgress = "KCP-IM"    // InfraMachine: set clonedFrom+in-progress
+	TransitionKCPInfraCleanup    = "KCP-IM-C"  // InfraMachine: remove in-progress
+	TransitionMDMove             = "MD-MOVE"   // Machine: ownerRef+label+2 annos (single patch)
+	TransitionMDFinalizeMachine  = "MD-FIN-M"  // Machine: spec.version+failureDomain
+	TransitionMDTrigger          = "MD-TRIG"   // Machine: add pending-hooks; drop pending-ack
+	TransitionMDCleanupHook      = "MD-C1"     // Machine: remove pending-hooks
+	TransitionMDCleanupFlag      = "MD-C2"     // Machine: remove update-in-progress
+	TransitionMDFinalizeInfra    = "MD-FIN-IM" // InfraMachine: set clonedFrom+in-progress
+	TransitionMDAcknowledge      = "MD-ACK"    // MachineSet: add acknowledged-move+receive-from
+)
+
+// knownTransitions is the closed set of recognized transition IDs.
+var knownTransitions = map[string]struct{}{
+	TransitionKCPSetInProgress:   {},
+	TransitionKCPVersionBump:     {},
+	TransitionKCPPendingHook:     {},
+	TransitionKCPCleanupHook:     {},
+	TransitionKCPCleanupFlag:     {},
+	TransitionKCPInfraInProgress: {},
+	TransitionKCPInfraCleanup:    {},
+	TransitionMDMove:             {},
+	TransitionMDFinalizeMachine:  {},
+	TransitionMDTrigger:          {},
+	TransitionMDCleanupHook:      {},
+	TransitionMDCleanupFlag:      {},
+	TransitionMDFinalizeInfra:    {},
+	TransitionMDAcknowledge:      {},
+}
+
+// validTargetKind reports whether k is a recognized target kind.
+func validTargetKind(k TargetKind) bool {
+	switch k {
+	case TargetKubeadmControlPlane, TargetMachineDeployment, TargetMachineSet:
+		return true
+	default:
+		return false
+	}
+}
+
+// Grant is the immutable ADR-047 Upgrade Grant together with its single-use
+// claim slot, as read READ-ONLY by the guard from the shared CAS object.
+//
+// The guard never mints, writes or consumes a grant; it only verifies it.
+type Grant struct {
+	GrantID             string
+	ClusterUID          string
+	TargetKind          TargetKind
+	TargetName          string
+	TargetUID           string
+	MachineUID          string // REQUIRED for KCP singleton; empty for MD set-move
+	FromVersion         string
+	ToVersion           string
+	Transitions         map[string]struct{}
+	PayloadDigest       string
+	NotAfter            time.Time
+	PermittedUseCount   int
+	RequestDigest       string
+	AuthorizationDigest string
+
+	// Claim slot, set out-of-band exactly once by the Upgrade-Initiator.
+	Claimed    bool
+	ClaimToken string
+}
+
+// AllowsTransition reports whether this grant enumerates the given transition ID.
+func (g *Grant) AllowsTransition(id string) bool {
+	if g == nil || id == "" {
+		return false
+	}
+	_, ok := g.Transitions[id]
+	return ok
+}
+
+// Grant ConfigMap keys (the shared CAS object; see M1 §1.1).
+const (
+	grantKeyGrantID             = "grantID"
+	grantKeyClusterUID          = "clusterUID"
+	grantKeyTargetKind          = "targetKind"
+	grantKeyTargetName          = "targetName"
+	grantKeyTargetUID           = "targetUID"
+	grantKeyMachineUID          = "machineUID"
+	grantKeyFromVersion         = "fromVersion"
+	grantKeyToVersion           = "toVersion"
+	grantKeyTransitions         = "transitions"
+	grantKeyPayloadDigest       = "payloadDigest"
+	grantKeyNotAfter            = "notAfter"
+	grantKeyPermittedUseCount   = "permittedUseCount"
+	grantKeyRequestDigest       = "requestDigest"
+	grantKeyAuthorizationDigest = "authorizationDigest"
+	// GrantClaimKey is the single claim slot key. It is the ONLY key the
+	// Upgrade-Initiator may add, and it may be added at most once.
+	GrantClaimKey = "claim"
+	// GrantLabel marks a ConfigMap as a protected Upgrade Grant CAS object.
+	GrantLabel = "safety.openkubes.org/grant"
+)
+
+// grantDataKeys is the closed set of immutable grant-data keys (the Approver's
+// write surface). The claim key is deliberately excluded.
+var grantDataKeys = map[string]struct{}{
+	grantKeyGrantID: {}, grantKeyClusterUID: {}, grantKeyTargetKind: {},
+	grantKeyTargetName: {}, grantKeyTargetUID: {}, grantKeyMachineUID: {},
+	grantKeyFromVersion: {}, grantKeyToVersion: {}, grantKeyTransitions: {},
+	grantKeyPayloadDigest: {}, grantKeyNotAfter: {}, grantKeyPermittedUseCount: {},
+	grantKeyRequestDigest: {}, grantKeyAuthorizationDigest: {},
+}
+
+// requiredGrantDataKeys must all be present on a well-formed grant.
+// machineUID is optional (KCP-only); every other data key is required.
+var requiredGrantDataKeys = []string{
+	grantKeyGrantID, grantKeyClusterUID, grantKeyTargetKind, grantKeyTargetName,
+	grantKeyTargetUID, grantKeyFromVersion, grantKeyToVersion, grantKeyTransitions,
+	grantKeyPayloadDigest, grantKeyNotAfter, grantKeyPermittedUseCount,
+	grantKeyRequestDigest, grantKeyAuthorizationDigest,
+}
+
+// ParseGrant strictly parses a grant from the shared CAS object's string map.
+//
+// It fails closed on any unknown key, missing required key, malformed value, or
+// an empty immutable field. The claim slot (GrantClaimKey) is optional: when
+// present and non-empty the grant is Claimed.
+func ParseGrant(data map[string]string) (*Grant, error) {
+	if len(data) == 0 {
+		return nil, fmt.Errorf("grant is empty")
+	}
+
+	// Reject any key that is neither a known data key nor the claim key.
+	for key := range data {
+		if key == GrantClaimKey {
+			continue
+		}
+		if _, ok := grantDataKeys[key]; !ok {
+			return nil, fmt.Errorf("grant contains unknown key %q", key)
+		}
+	}
+
+	for _, key := range requiredGrantDataKeys {
+		v, ok := data[key]
+		if !ok || strings.TrimSpace(v) == "" {
+			return nil, fmt.Errorf("grant is missing required key %q", key)
+		}
+	}
+
+	g := &Grant{
+		GrantID:             data[grantKeyGrantID],
+		ClusterUID:          data[grantKeyClusterUID],
+		TargetKind:          TargetKind(data[grantKeyTargetKind]),
+		TargetName:          data[grantKeyTargetName],
+		TargetUID:           data[grantKeyTargetUID],
+		MachineUID:          strings.TrimSpace(data[grantKeyMachineUID]),
+		FromVersion:         data[grantKeyFromVersion],
+		ToVersion:           data[grantKeyToVersion],
+		PayloadDigest:       data[grantKeyPayloadDigest],
+		RequestDigest:       data[grantKeyRequestDigest],
+		AuthorizationDigest: data[grantKeyAuthorizationDigest],
+	}
+
+	if !validTargetKind(g.TargetKind) {
+		return nil, fmt.Errorf("grant has invalid targetKind %q", g.TargetKind)
+	}
+	if g.FromVersion == g.ToVersion {
+		return nil, fmt.Errorf("grant fromVersion and toVersion must differ")
+	}
+
+	transitions, err := parseTransitions(data[grantKeyTransitions])
+	if err != nil {
+		return nil, err
+	}
+	g.Transitions = transitions
+
+	notAfter, err := time.Parse(time.RFC3339, strings.TrimSpace(data[grantKeyNotAfter]))
+	if err != nil {
+		return nil, fmt.Errorf("grant notAfter is not RFC3339: %w", err)
+	}
+	g.NotAfter = notAfter
+
+	count, err := strconv.Atoi(strings.TrimSpace(data[grantKeyPermittedUseCount]))
+	if err != nil || count != 1 {
+		return nil, fmt.Errorf("grant permittedUseCount must be exactly 1")
+	}
+	g.PermittedUseCount = count
+
+	// KCP singleton grants MUST bind a Machine UID.
+	if g.TargetKind == TargetKubeadmControlPlane && g.MachineUID == "" {
+		return nil, fmt.Errorf("KubeadmControlPlane grant must bind machineUID")
+	}
+
+	if claim, ok := data[GrantClaimKey]; ok && strings.TrimSpace(claim) != "" {
+		g.Claimed = true
+		g.ClaimToken = claim
+	}
+
+	return g, nil
+}
+
+// parseTransitions parses a comma-separated, non-empty list of known transition
+// IDs into a set, rejecting unknown or duplicate IDs.
+func parseTransitions(raw string) (map[string]struct{}, error) {
+	parts := strings.Split(raw, ",")
+	out := make(map[string]struct{}, len(parts))
+	for _, p := range parts {
+		id := strings.TrimSpace(p)
+		if id == "" {
+			continue
+		}
+		if _, ok := knownTransitions[id]; !ok {
+			return nil, fmt.Errorf("grant lists unknown transition %q", id)
+		}
+		if _, dup := out[id]; dup {
+			return nil, fmt.Errorf("grant lists duplicate transition %q", id)
+		}
+		out[id] = struct{}{}
+	}
+	if len(out) == 0 {
+		return nil, fmt.Errorf("grant lists no transitions")
+	}
+	return out, nil
+}
+
+// GrantQuery is the admission context handed to VerifyGrant by the per-object
+// handlers. It carries ONLY facts the handler has independently established:
+// the live cluster UID, the owner object the admitted change binds to, the
+// transition the diff was classified as, and (when relevant) the observed
+// version delta and the digest of the ACTUAL InstallationSecret payload bytes.
+type GrantQuery struct {
+	DryRun          bool
+	ClusterUID      string
+	TargetKind      TargetKind
+	TargetUID       string
+	MachineUID      string
+	Transition      string
+	VersionRelevant bool
+	FromVersion     string
+	ToVersion       string
+	PayloadRelevant bool
+	PayloadDigest   string
+	Now             time.Time
+}
+
+// VerifyGrant is the read-only authorization predicate (M1 §1.5 / §1.6).
+//
+// It returns allow() only when every binding holds; otherwise it fails closed.
+// For dry-run requests the single-use claim is NOT required and is never treated
+// as consumed (M1 §1.6), so that CAPI's CanUpdateMachine diff probe can proceed
+// without falling back to a dangerous replacement on a singleton control plane.
+func VerifyGrant(scope Scope, grant *Grant, q GrantQuery) Decision {
+	if !scope.Verified {
+		return deny(reasonScopeUnverified)
+	}
+	if !scope.Protected {
+		// Unprotected scope is outside the in-place-only policy entirely.
+		return allow()
+	}
+
+	if grant == nil {
+		return deny("in-place update requires an authorized upgrade grant")
+	}
+	if q.Now.IsZero() {
+		return deny("grant verification requires a trusted current time")
+	}
+	if !grant.NotAfter.IsZero() && !q.Now.Before(grant.NotAfter) {
+		return deny("upgrade grant has expired")
+	}
+	if q.ClusterUID == "" || grant.ClusterUID != q.ClusterUID {
+		return deny("upgrade grant is not bound to this cluster")
+	}
+	if !validTargetKind(q.TargetKind) ||
+		grant.TargetKind != q.TargetKind ||
+		grant.TargetUID == "" ||
+		grant.TargetUID != q.TargetUID {
+		return deny("upgrade grant is not bound to this target object")
+	}
+	// KCP singleton: the grant binds an exact Machine UID.
+	if grant.MachineUID != "" && q.MachineUID != "" && grant.MachineUID != q.MachineUID {
+		return deny("upgrade grant is not bound to this Machine")
+	}
+	if q.Transition == "" {
+		return deny("change is not a recognized in-place transition")
+	}
+	if !grant.AllowsTransition(q.Transition) {
+		return deny(fmt.Sprintf("transition %q is not authorized by the upgrade grant", q.Transition))
+	}
+	if q.VersionRelevant {
+		if grant.FromVersion != q.FromVersion || grant.ToVersion != q.ToVersion {
+			return deny("version transition does not match the upgrade grant")
+		}
+	}
+	if q.PayloadRelevant {
+		if grant.PayloadDigest == "" || q.PayloadDigest == "" ||
+			subtle.ConstantTimeCompare([]byte(grant.PayloadDigest), []byte(q.PayloadDigest)) != 1 {
+			return deny("installation payload digest does not match the upgrade grant")
+		}
+	}
+	if !q.DryRun {
+		if !grant.Claimed {
+			return deny("upgrade grant has not been claimed by the upgrade initiator")
+		}
+		if grant.PermittedUseCount < 1 {
+			return deny("upgrade grant single-use has been exhausted")
+		}
+	}
+	return allow()
+}
+
+// TransitionList returns a grant's authorized transition IDs, sorted (for logs/tests).
+func (g *Grant) TransitionList() []string {
+	if g == nil {
+		return nil
+	}
+	out := make([]string, 0, len(g.Transitions))
+	for id := range g.Transitions {
+		out = append(out, id)
+	}
+	sort.Strings(out)
+	return out
+}
diff --git a/internal/safety/noreplacement/grantclaim.go b/internal/safety/noreplacement/grantclaim.go
new file mode 100644
index 0000000..6998901
--- /dev/null
+++ b/internal/safety/noreplacement/grantclaim.go
@@ -0,0 +1,105 @@
+// Copyright 2026 The Cluster API Provider BringYourOwnHost Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package noreplacement
+
+import "fmt"
+
+// GrantActor is the authenticated role of the requester mutating the shared
+// grant CAS object. Identity is established from admission userInfo (and backed
+// by RBAC); this policy enforces the field-level separation RBAC cannot express.
+type GrantActor string
+
+const (
+	// ActorApprover creates the immutable grant data block (never the claim).
+	ActorApprover GrantActor = "approver"
+	// ActorInitiator may add the claim slot exactly once (never grant data).
+	ActorInitiator GrantActor = "initiator"
+	// ActorOther is any other identity; it may not mutate a grant at all.
+	ActorOther GrantActor = "other"
+)
+
+// EvaluateGrantConfigMap enforces the role/field separation and single-use claim
+// semantics of the shared CAS grant object (M1 §1.2, §1.3):
+//
+//   - CREATE  (Approver):   immutable data block, NO claim key.
+//   - UPDATE  (Initiator):  the ONLY permitted delta is adding the claim key
+//     exactly once; every data key must be byte-identical.
+//   - DELETE / data mutation / re-claim / wrong actor: denied, fail-closed.
+//
+// The apiserver's optimistic concurrency (resourceVersion CAS) guarantees that
+// of two concurrent claim UPDATEs exactly one is admitted; this policy denies
+// any UPDATE whose OLD object already carries a claim, closing the race from the
+// admission side as well. The guard writes nothing here — it only admits/denies.
+func EvaluateGrantConfigMap(
+	op Operation,
+	actor GrantActor,
+	oldData map[string]string,
+	newData map[string]string,
+) Decision {
+
+	switch op {
+	case Create:
+		if actor != ActorApprover {
+			return deny("only the approver may create an upgrade grant")
+		}
+		// A freshly created grant must be well-formed and must NOT be pre-claimed.
+		if _, hasClaim := newData[GrantClaimKey]; hasClaim {
+			return deny("a new upgrade grant must not contain a claim")
+		}
+		if _, err := ParseGrant(newData); err != nil {
+			return deny(fmt.Sprintf("invalid upgrade grant: %v", err))
+		}
+		return allow()
+
+	case Update:
+		if actor != ActorInitiator {
+			return deny("only the upgrade initiator may update an upgrade grant")
+		}
+		// Single-use: the grant must not already be claimed.
+		if oldClaim, ok := oldData[GrantClaimKey]; ok && oldClaim != "" {
+			return deny("upgrade grant has already been claimed (single-use)")
+		}
+		// The only permitted delta is adding a non-empty claim key.
+		newClaim, hasNewClaim := newData[GrantClaimKey]
+		if !hasNewClaim || newClaim == "" {
+			return deny("upgrade grant update must set the claim")
+		}
+		// Every immutable data key must be byte-identical (no add/remove/change).
+		if !sameExceptClaim(oldData, newData) {
+			return deny("upgrade grant data is immutable; only the claim may be added")
+		}
+		return allow()
+
+	case Delete:
+		return deny("upgrade grant deletion is not permitted during an in-place lifecycle")
+
+	default:
+		return deny(fmt.Sprintf("unsupported upgrade grant operation %q", op))
+	}
+}
+
+// sameExceptClaim reports whether oldData and newData are identical on every key
+// other than the claim slot (which newData is allowed to add). It rejects any
+// added, removed or modified data key.
+func sameExceptClaim(oldData, newData map[string]string) bool {
+	for k, ov := range oldData {
+		if k == GrantClaimKey {
+			continue
+		}
+		nv, ok := newData[k]
+		if !ok || nv != ov {
+			return false
+		}
+	}
+	for k, nv := range newData {
+		if k == GrantClaimKey {
+			continue
+		}
+		ov, ok := oldData[k]
+		if !ok || ov != nv {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/safety/noreplacement/grant_test.go b/internal/safety/noreplacement/grant_test.go
new file mode 100644
index 0000000..c1724ff
--- /dev/null
+++ b/internal/safety/noreplacement/grant_test.go
@@ -0,0 +1,221 @@
+// Copyright 2026 The Cluster API Provider BringYourOwnHost Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package noreplacement
+
+import (
+	"testing"
+	"time"
+)
+
+func validKCPGrantData() map[string]string {
+	return map[string]string{
+		grantKeyGrantID:             "g-1",
+		grantKeyClusterUID:          "cluster-uid-1",
+		grantKeyTargetKind:          string(TargetKubeadmControlPlane),
+		grantKeyTargetName:          "kcp-1",
+		grantKeyTargetUID:           "kcp-uid-1",
+		grantKeyMachineUID:          "machine-uid-1",
+		grantKeyFromVersion:         "v1.33.4",
+		grantKeyToVersion:           "v1.34.1",
+		grantKeyTransitions:         "KCP-1,KCP-2,KCP-3,KCP-C1,KCP-C2,KCP-IM,KCP-IM-C",
+		grantKeyPayloadDigest:       "sha256:abc",
+		grantKeyNotAfter:            time.Now().Add(1 * time.Hour).Format(time.RFC3339),
+		grantKeyPermittedUseCount:   "1",
+		grantKeyRequestDigest:       "sha256:req",
+		grantKeyAuthorizationDigest: "sha256:auth",
+	}
+}
+
+func validMDGrantData() map[string]string {
+	d := validKCPGrantData()
+	d[grantKeyTargetKind] = string(TargetMachineDeployment)
+	d[grantKeyTargetName] = "md-1"
+	d[grantKeyTargetUID] = "md-uid-1"
+	delete(d, grantKeyMachineUID) // MD set-move binds no single Machine UID
+	d[grantKeyTransitions] = "MD-MOVE,MD-FIN-M,MD-TRIG,MD-C1,MD-C2,MD-FIN-IM"
+	return d
+}
+
+func TestParseGrant_Valid(t *testing.T) {
+	g, err := ParseGrant(validKCPGrantData())
+	if err != nil {
+		t.Fatalf("expected valid grant, got error: %v", err)
+	}
+	if g.Claimed {
+		t.Fatalf("grant without claim key must not be Claimed")
+	}
+	if !g.AllowsTransition(TransitionKCPVersionBump) {
+		t.Fatalf("expected KCP-2 to be allowed")
+	}
+	if g.AllowsTransition(TransitionMDMove) {
+		t.Fatalf("MD-MOVE must not be allowed by a KCP grant")
+	}
+}
+
+func TestParseGrant_ClaimPresent(t *testing.T) {
+	d := validKCPGrantData()
+	d[GrantClaimKey] = "claim-token-xyz"
+	g, err := ParseGrant(d)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if !g.Claimed || g.ClaimToken != "claim-token-xyz" {
+		t.Fatalf("expected grant to be claimed with token")
+	}
+}
+
+func TestParseGrant_Rejections(t *testing.T) {
+	tests := []struct {
+		name   string
+		mutate func(map[string]string)
+	}{
+		{"unknown key", func(d map[string]string) { d["bogus"] = "x" }},
+		{"missing required", func(d map[string]string) { delete(d, grantKeyClusterUID) }},
+		{"empty required", func(d map[string]string) { d[grantKeyToVersion] = "  " }},
+		{"useCount not 1", func(d map[string]string) { d[grantKeyPermittedUseCount] = "2" }},
+		{"unknown transition", func(d map[string]string) { d[grantKeyTransitions] = "KCP-2,BOGUS" }},
+		{"duplicate transition", func(d map[string]string) { d[grantKeyTransitions] = "KCP-2,KCP-2" }},
+		{"no transitions", func(d map[string]string) { d[grantKeyTransitions] = " , " }},
+		{"from==to", func(d map[string]string) { d[grantKeyToVersion] = d[grantKeyFromVersion] }},
+		{"bad notAfter", func(d map[string]string) { d[grantKeyNotAfter] = "not-a-time" }},
+		{"invalid targetKind", func(d map[string]string) { d[grantKeyTargetKind] = "Pod" }},
+		{"KCP without machineUID", func(d map[string]string) { delete(d, grantKeyMachineUID) }},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			d := validKCPGrantData()
+			tc.mutate(d)
+			if _, err := ParseGrant(d); err == nil {
+				t.Fatalf("expected rejection for %q, got none", tc.name)
+			}
+		})
+	}
+}
+
+func protectedScope() Scope { return Scope{Verified: true, Protected: true} }
+
+func baseKCPQuery() GrantQuery {
+	return GrantQuery{
+		DryRun:          false,
+		ClusterUID:      "cluster-uid-1",
+		TargetKind:      TargetKubeadmControlPlane,
+		TargetUID:       "kcp-uid-1",
+		MachineUID:      "machine-uid-1",
+		Transition:      TransitionKCPVersionBump,
+		VersionRelevant: true,
+		FromVersion:     "v1.33.4",
+		ToVersion:       "v1.34.1",
+		PayloadRelevant: false,
+		Now:             time.Now(),
+	}
+}
+
+func claimedKCPGrant(t *testing.T) *Grant {
+	t.Helper()
+	d := validKCPGrantData()
+	d[GrantClaimKey] = "claim-1"
+	g, err := ParseGrant(d)
+	if err != nil {
+		t.Fatalf("setup grant: %v", err)
+	}
+	return g
+}
+
+func TestVerifyGrant_AllowClaimed(t *testing.T) {
+	d := VerifyGrant(protectedScope(), claimedKCPGrant(t), baseKCPQuery())
+	if !d.Allowed {
+		t.Fatalf("expected allow, got deny: %s", d.Reason)
+	}
+}
+
+func TestVerifyGrant_Denials(t *testing.T) {
+	tests := []struct {
+		name   string
+		grant  func(*testing.T) *Grant
+		mutate func(*GrantQuery)
+	}{
+		{"nil grant", func(*testing.T) *Grant { return nil }, func(*GrantQuery) {}},
+		{"wrong cluster", claimedKCPGrant, func(q *GrantQuery) { q.ClusterUID = "other" }},
+		{"wrong target uid", claimedKCPGrant, func(q *GrantQuery) { q.TargetUID = "other" }},
+		{"wrong target kind", claimedKCPGrant, func(q *GrantQuery) { q.TargetKind = TargetMachineDeployment }},
+		{"wrong machine uid", claimedKCPGrant, func(q *GrantQuery) { q.MachineUID = "other" }},
+		{"transition empty", claimedKCPGrant, func(q *GrantQuery) { q.Transition = "" }},
+		{"transition not granted", claimedKCPGrant, func(q *GrantQuery) { q.Transition = TransitionMDMove }},
+		{"version mismatch", claimedKCPGrant, func(q *GrantQuery) { q.ToVersion = "v1.99.9" }},
+		{"zero now", claimedKCPGrant, func(q *GrantQuery) { q.Now = time.Time{} }},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			q := baseKCPQuery()
+			tc.mutate(&q)
+			d := VerifyGrant(protectedScope(), tc.grant(t), q)
+			if d.Allowed {
+				t.Fatalf("expected deny for %q, got allow", tc.name)
+			}
+		})
+	}
+}
+
+func TestVerifyGrant_Expired(t *testing.T) {
+	d := validKCPGrantData()
+	d[GrantClaimKey] = "claim-1"
+	d[grantKeyNotAfter] = time.Now().Add(-1 * time.Minute).Format(time.RFC3339)
+	g, err := ParseGrant(d)
+	if err != nil {
+		t.Fatalf("setup: %v", err)
+	}
+	if VerifyGrant(protectedScope(), g, baseKCPQuery()).Allowed {
+		t.Fatalf("expired grant must be denied")
+	}
+}
+
+// Two competing claims: the loser never acquires the claim, so its real
+// (non-dry-run) in-place write must be denied for lack of a claim.
+func TestVerifyGrant_UnclaimedRealWriteDenied(t *testing.T) {
+	g, err := ParseGrant(validKCPGrantData()) // no claim
+	if err != nil {
+		t.Fatalf("setup: %v", err)
+	}
+	if VerifyGrant(protectedScope(), g, baseKCPQuery()).Allowed {
+		t.Fatalf("unclaimed grant must deny a real in-place write")
+	}
+}
+
+// Dry-run must be allowed WITHOUT a claim (M1 §1.6) so CanUpdateMachine's diff
+// probe does not force a replacement on a singleton control plane.
+func TestVerifyGrant_DryRunAllowedWithoutClaim(t *testing.T) {
+	g, err := ParseGrant(validKCPGrantData()) // no claim
+	if err != nil {
+		t.Fatalf("setup: %v", err)
+	}
+	q := baseKCPQuery()
+	q.DryRun = true
+	if !VerifyGrant(protectedScope(), g, q).Allowed {
+		t.Fatalf("dry-run probe must be allowed without a claim")
+	}
+}
+
+func TestVerifyGrant_PayloadDigest(t *testing.T) {
+	g := claimedKCPGrant(t) // PayloadDigest sha256:abc
+	q := baseKCPQuery()
+	q.PayloadRelevant = true
+	q.PayloadDigest = "sha256:abc"
+	if !VerifyGrant(protectedScope(), g, q).Allowed {
+		t.Fatalf("matching payload digest must allow")
+	}
+	q.PayloadDigest = "sha256:WRONG"
+	if VerifyGrant(protectedScope(), g, q).Allowed {
+		t.Fatalf("mismatched payload digest must deny")
+	}
+}
+
+func TestVerifyGrant_Scope(t *testing.T) {
+	if VerifyGrant(Scope{}, claimedKCPGrant(t), baseKCPQuery()).Allowed {
+		t.Fatalf("unverified scope must deny")
+	}
+	// Unprotected scope is outside the policy; allow regardless of grant.
+	if !VerifyGrant(Scope{Verified: true, Protected: false}, nil, baseKCPQuery()).Allowed {
+		t.Fatalf("unprotected scope must allow")
+	}
+}
diff --git a/internal/safety/noreplacement/grantclaim_test.go b/internal/safety/noreplacement/grantclaim_test.go
new file mode 100644
index 0000000..44f9d22
--- /dev/null
+++ b/internal/safety/noreplacement/grantclaim_test.go
@@ -0,0 +1,104 @@
+// Copyright 2026 The Cluster API Provider BringYourOwnHost Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package noreplacement
+
+import "testing"
+
+func TestGrantConfigMap_CreateByApprover(t *testing.T) {
+	d := VerifyGrantCreate(t, ActorApprover, validKCPGrantData())
+	if !d.Allowed {
+		t.Fatalf("approver create of a valid grant must be allowed: %s", d.Reason)
+	}
+}
+
+// helper wrappers keep the table tests readable.
+func VerifyGrantCreate(t *testing.T, actor GrantActor, newData map[string]string) Decision {
+	t.Helper()
+	return EvaluateGrantConfigMap(Create, actor, nil, newData)
+}
+
+func TestGrantConfigMap_CreateRejections(t *testing.T) {
+	t.Run("non-approver create", func(t *testing.T) {
+		if EvaluateGrantConfigMap(Create, ActorInitiator, nil, validKCPGrantData()).Allowed {
+			t.Fatalf("only the approver may create a grant")
+		}
+	})
+	t.Run("create with pre-set claim", func(t *testing.T) {
+		d := validKCPGrantData()
+		d[GrantClaimKey] = "sneaky"
+		if EvaluateGrantConfigMap(Create, ActorApprover, nil, d).Allowed {
+			t.Fatalf("a new grant must not be pre-claimed")
+		}
+	})
+	t.Run("create with invalid data", func(t *testing.T) {
+		d := validKCPGrantData()
+		delete(d, grantKeyClusterUID)
+		if EvaluateGrantConfigMap(Create, ActorApprover, nil, d).Allowed {
+			t.Fatalf("invalid grant data must be rejected at create")
+		}
+	})
+}
+
+func TestGrantConfigMap_InitiatorClaim(t *testing.T) {
+	old := validKCPGrantData() // unclaimed
+	newData := validKCPGrantData()
+	newData[GrantClaimKey] = "claim-1"
+	if !EvaluateGrantConfigMap(Update, ActorInitiator, old, newData).Allowed {
+		t.Fatalf("initiator adding a claim to an unclaimed grant must be allowed")
+	}
+}
+
+// Two competing claims: the first wins; the second observes a claim already
+// present on the OLD object and is denied (exactly one winner).
+func TestGrantConfigMap_SecondClaimDenied(t *testing.T) {
+	old := validKCPGrantData()
+	old[GrantClaimKey] = "claim-first" // already claimed
+	newData := validKCPGrantData()
+	newData[GrantClaimKey] = "claim-second"
+	if EvaluateGrantConfigMap(Update, ActorInitiator, old, newData).Allowed {
+		t.Fatalf("a second claim must be denied (single-use)")
+	}
+}
+
+func TestGrantConfigMap_UpdateRejections(t *testing.T) {
+	t.Run("non-initiator update", func(t *testing.T) {
+		old := validKCPGrantData()
+		newData := validKCPGrantData()
+		newData[GrantClaimKey] = "c"
+		if EvaluateGrantConfigMap(Update, ActorApprover, old, newData).Allowed {
+			t.Fatalf("only the initiator may claim")
+		}
+	})
+	t.Run("update without claim", func(t *testing.T) {
+		old := validKCPGrantData()
+		newData := validKCPGrantData() // no claim added
+		if EvaluateGrantConfigMap(Update, ActorInitiator, old, newData).Allowed {
+			t.Fatalf("an update that does not set the claim must be denied")
+		}
+	})
+	t.Run("mutate a data key while claiming", func(t *testing.T) {
+		old := validKCPGrantData()
+		newData := validKCPGrantData()
+		newData[grantKeyToVersion] = "v9.9.9" // tamper
+		newData[GrantClaimKey] = "c"
+		if EvaluateGrantConfigMap(Update, ActorInitiator, old, newData).Allowed {
+			t.Fatalf("grant data must be immutable on claim")
+		}
+	})
+	t.Run("add a data key while claiming", func(t *testing.T) {
+		old := validKCPGrantData()
+		newData := validKCPGrantData()
+		newData["extraKey"] = "x"
+		newData[GrantClaimKey] = "c"
+		if EvaluateGrantConfigMap(Update, ActorInitiator, old, newData).Allowed {
+			t.Fatalf("adding a data key must be denied")
+		}
+	})
+}
+
+func TestGrantConfigMap_DeleteDenied(t *testing.T) {
+	if EvaluateGrantConfigMap(Delete, ActorApprover, validKCPGrantData(), nil).Allowed {
+		t.Fatalf("grant deletion must be denied during an in-place lifecycle")
+	}
+}
